{
  "$schema": "./schemas/grammar.schema.json",
  "id": "html",
  "name": "HTML",
  "version": "1.0.0",
  "formatter": "generic-tag",
  "extensions": [".html", ".htm"],
  "detection": {
    "patterns": [
      "</?[a-zA-Z][^>]*>",
      "<!DOCTYPE",
      "\\shref=|\\ssrc=|\\sclass="
    ]
  },
  "keywords": {},
  "tokens": [
    { "type": "comment.block",  "pattern": "<!--[\\s\\S]*?-->" },
    { "type": "comment.block",  "pattern": "<!\\[CDATA\\[[\\s\\S]*?\\]\\]>" },
    { "type": "comment.block",  "pattern": "<!DOCTYPE[^>]*>" },
    { "type": "tag",            "pattern": "</?[A-Za-z][\\w:-]*" },
    { "type": "attribute",      "pattern": "[A-Za-z_][\\w:-]*(?=\\s*=)" },
    { "type": "string",         "pattern": "\"[^\"]*\"|'[^']*'" },
    { "type": "operator",       "pattern": "=" },
    { "type": "punctuation",    "pattern": "[/>]" },
    { "type": "identifier",     "pattern": "[A-Za-z_][\\w-]*" }
  ]
}
